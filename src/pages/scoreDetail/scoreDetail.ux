@import '../../common/style.css';

.page {
  flex-direction: column;
}

.score-list {
  margin-top: -16px;
  padding: 0 6px;
  flex-direction: column;
  align-items: center;
}

.score-card {
  width: 100%;
  height: 174px;
  border-radius: 36px;
  margin-bottom: 8px;
  padding: 14px 19px;
  background-color: rgba(38, 38, 38, 1);
  border: 3px solid rgba(255, 255, 255, 0.03);
  flex-direction: column;
}

.card-header {
  width: 100%;
  height: 42px;
  justify-content: space-between;
  align-items: center;
}

.cube-title {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.cube-desc {
  font-size: 22px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}

.score-row {
  width: 100%;
  height: 34px;
  justify-content: space-between;
  align-items: center;
}

.score-label {
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
}

.score-value {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
</style>
