<template>
  <div class="page">
    <div class="header">
      <img src="/common/images/hd.png" class="header-bg" />
      <text class="system-time">{{ currentTime }}</text>
      <text class="page-title">构建信息</text>
      <img class="nav-icon back-btn" src="/common/images/back.png" @click="back" />
    </div>

    <div class="content">
      <div class="info-card">
        <div class="info-item">
          <text class="info-label">构建用户</text>
          <text class="info-value">{{ buildUser }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">构建时间</text>
          <text class="info-value">{{ buildDate }}</text>
          <text class="info-value">{{ buildClock }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">aiot-toolkit</text>
          <text class="info-value">{{ toolkitVersion }}</text>
        </div>
        <div class="info-item">
          <text class="info-label">Node.js</text>
          <text class="info-value">{{ nodeVersion }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

export default {
  private: {
    currentTime: "00:00",
    timeSyncInterval: null,
    buildUser: "HyOxygen",
    buildDate: "2026年05月04日",
    buildClock: "13时51分55秒",
    toolkitVersion: "v2.0.5",
    nodeVersion: "v24.11.0"
  },

  onInit() {
    this.syncGlobalTime()
  },

  onShow() {
    this.syncGlobalTime()
    this.timeSyncInterval = setInterval(() => this.syncGlobalTime(), 1000)
  },

  onHide() {
    clearInterval(this.timeSyncInterval)
  },

  syncGlobalTime() {
    const globalData = this.$app.$def.globalData
    if (globalData && globalData.systemTime) {
      this.currentTime = globalData.systemTime
    }
  },

  back() {
    router.back()
  }
}
</script>

