<template>
  <div class="page" ontouchstart="handleGlobalTouchStart">
    <div class="header">
      <text class="page-title">计时器</text>
      <img class="nav-icon back-btn" src="/common/images/back.png" @click="back" />
      <img class="nav-icon more-btn" src="/common/images/more.png" @click="more" />
      <text class="system-time">{{ currentTime }}</text>
    </div>

    <text style="color: #ffaa00; font-size: 20px" if="{{ penaltyText !== '' }}">
      {{ penaltyText }}
    </text>

    <div class="main-content" ontouchstart="handleTouchStart" ontouchend="handleTouchEnd">
      <div class="timer-box">
        <div class="timer-row" if="{{ !isShowPreview }}">
          <block if="{{ timeInt === 'DNF' }}">
            <text class="timer-text-main {{ timerStatus }}">DNF</text>
          </block>
          <block else>
            <text class="timer-text-main {{ timerStatus }}">{{ timeInt }}.</text>
            <text class="timer-text-small {{ timerStatus }}">{{ timeFraction }}</text>
          </block>
        </div>

        <div class="preview-center-box" if="{{ isShowPreview }}" onclick="hidePreview">
          <stack class="cube-area">
            <block for="{{ face in faces }}">
              <stack class="face" style="left: {{ face.pos.x }}px; top: {{ face.pos.y }}px;">
                <div
                  for="{{ dot in face.data }}"
                  class="dot"
                  style="left: {{ dot.x }}px; top: {{ dot.y }}px; width: {{ dot.size }}px; height: {{ dot.size }}px; background-color: {{ colorMap[dot.color] }};"
                ></div>
              </stack>
            </block>
          </stack>
        </div>

        <div class="hint-container">
          <text class="hint-text">
            {{ isShowPreview ? "点击屏幕恢复计时" : hintMap[timerStatus] }}
          </text>
        </div>
      </div>
    </div>

    <div class="scramble-container">
      <block if="{{ !isShowActions }}">
        <div
          class="scramble-click-area {{ hasInteracted ? (isScrambleExiting ? 'menu-pop-out' : 'menu-pop-in') : '' }}"
          ontouchstart="setPress('scramble', true)"
          ontouchend="handleScrambleClick"
          ontouchcancel="setPress('scramble', false)"
        >
          <text class="scramble-text">{{ scrambleString }}</text>
        </div>
      </block>
      <block if="{{ isShowActions }}">
        <div class="action-menu {{ isMenuExiting ? 'menu-pop-out' : 'menu-pop-in' }}">
          <text
            class="action-btn {{ isBtn1Pressed ? 'press-active' : '' }}"
            ontouchstart="setPress('btn1', true)"
            ontouchend="onAction('refresh')"
            ontouchcancel="setPress('btn1', false)"
          >
            换一条
          </text>
          <div class="menu-line"></div>
          <text
            class="action-btn {{ isBtn2Pressed ? 'press-active' : '' }}"
            ontouchstart="setPress('btn2', true)"
            ontouchend="onAction('preview')"
            ontouchcancel="setPress('btn2', false)"
          >
            预览图
          </text>
        </div>
      </block>
    </div>
    <div
      class="touch-blocker"
      if="{{ timerStatus === 'running' }}"
      ontouchstart="handleBlockTouch"
    ></div>
  </div>
</template>

<script>
import Cube2Core from "../../utils/cube2.js"
import Cube3Core from "../../utils/cube3.js"
import router from "@system.router"
import brightness from "@system.brightness"
import app from "@system.app"
import file from "@system.file"
import prompt from "@system.prompt"

export default {
  private: {
    currentTime: "00:00",
    scrambleString: " ",
    timeInt: "0",
    timeFraction: "000",
    timerStatus: "idle",
    startTime: 0,
    timerInterval: null,
    timeSyncInterval: null,
    isShowPreview: false,
    isShowActions: false,
    isMenuExiting: false,
    isScrambleExiting: false,
    hasInteracted: false,
    faces: [],
    currentType: "3x3",
    CONFIG_PATH: "internal://files/cube_settings.json",
    SCORES_PATH: "internal://files/cube_scores.json",
    bestTimes: {"2x2": null, "3x3": null},
    scoreRecords: {"2x2": [], "3x3": []},
    isScramblePressed: false,
    isBtn1Pressed: false,
    isBtn2Pressed: false,

    inspectionEnabled: true,
    isInspecting: false,
    inspectionTime: 15,
    inspectionStartTime: 0,
    inspectionEndTime: 0,
    inspectionTimer: null,
    overtime: 0,
    overtimeTimer: null,
    penalty: 0,
    isDNF: false,
    penaltyText: "",

    colorMap: {U: "#ffffff", D: "#ffff00", L: "#ffa500", R: "#ff0000", F: "#00ff00", B: "#0000ff"},
    layout: {
      U: {x: 64, y: 0},
      L: {x: 0, y: 64},
      F: {x: 64, y: 64},
      R: {x: 128, y: 64},
      D: {x: 64, y: 128},
      B: {x: 192, y: 64}
    },
    hintMap: {
      idle: "长按准备",
      prepping: "继续按住...",
      ready: "松开开始",
      overtime: "超时",
      running: "点击屏幕停止"
    }
  },

  onInit() {
    this.clearAllScores()
    this.updateClock()
    this.loadLocalConfig()
  },

  onShow() {
    brightness.setKeepScreenOn({keepScreenOn: true})
    this.updateClock()
    this.timeSyncInterval = setInterval(() => this.updateClock(), 1000)
    this.syncFromGlobal()

    const globalData = this.$app.$def.globalData
    if (globalData) {
      this.inspectionEnabled = !!globalData.inspection
    }
    const appDef = this.$app.$def
    appDef.onInspectionChanged = (val) => {
      this.inspectionEnabled = val
      if (!val) {
        this.stopAllInspection()
      }
    }
  },

  onHide() {
    brightness.setKeepScreenOn({keepScreenOn: false})
    clearInterval(this.timeSyncInterval)
    this.stopTimer()
    const appDef = this.$app.$def
    appDef.onInspectionChanged = null
  },

  clearAllScores() {
    const globalData = this.$app.$def.globalData

    // ✅ 1. 清空内存
    if (globalData) {
      globalData.bestTimes = {"2x2": null, "3x3": null}
      globalData.scoreRecords = {"2x2": [], "3x3": []}
    }

    // ✅ 2. 清空本地成绩文件
    const file = require("@system.file")
    file.writeText({
      uri: this.SCORES_PATH,
      text: JSON.stringify({
        bestTimes: {"2x2": null, "3x3": null},
        scoreRecords: {"2x2": [], "3x3": []}
      }),
      success: () => {
        console.log("成绩已清空（本地+全局）")
      },
      fail: () => {
        console.error("清空成绩文件失败")
      }
    })
  },

  handleGlobalTouchStart() {
    if (this.timerStatus === "running") {
      this.stopTimer()
    }
  },

  handleBlockTouch() {
    if (this.timerStatus === "running") {
      this.stopTimer()
    }
  },

  stopAllInspection() {
    if (this.inspectionTimer) {
      clearInterval(this.inspectionTimer)
      this.inspectionTimer = null
    }
    if (this.overtimeTimer) {
      clearInterval(this.overtimeTimer)
      this.overtimeTimer = null
    }
    this.isInspecting = false
  },

  loadLocalConfig() {
    const self = this
    // 读取配置
    file.readText({
      uri: this.CONFIG_PATH,
      success: function (data) {
        try {
          const config = JSON.parse(data.text)
          if (config.currentCubeType) {
            self.currentType = config.currentCubeType
            if (self.$app.$def.globalData) {
              self.$app.$def.globalData.currentCubeType = config.currentCubeType
            }
            self.generateNewScramble()
          }
          if (typeof config.inspection !== "undefined") {
            self.inspectionEnabled = config.inspection
            if (self.$app.$def.globalData) {
              self.$app.$def.globalData.inspection = config.inspection
            }
          }
        } catch (e) {}
      },
      fail: function () {
        self.syncFromGlobal()
        self.generateNewScramble()
      }
    })
    // 读取成绩（应用启动时已清空，此处仅做同步）
    file.readText({
      uri: this.SCORES_PATH,
      success: function (data) {
        try {
          const scores = JSON.parse(data.text)
          if (scores.bestTimes) {
            self.bestTimes = Object.assign({"2x2": null, "3x3": null}, scores.bestTimes)
            if (self.$app.$def.globalData) {
              self.$app.$def.globalData.bestTimes = self.bestTimes
            }
          }
          if (scores.scoreRecords) {
            self.scoreRecords = Object.assign({"2x2": [], "3x3": []}, scores.scoreRecords)
            if (self.$app.$def.globalData) {
              self.$app.$def.globalData.scoreRecords = self.scoreRecords
            }
          }
        } catch (e) {}
      }
    })
  },

  syncFromGlobal() {
    const globalData = this.$app.$def.globalData
    if (globalData && globalData.currentCubeType) {
      if (this.currentType !== globalData.currentCubeType) {
        this.currentType = globalData.currentCubeType
        this.generateNewScramble()
      }
    }
    if (globalData && globalData.bestTimes) {
      this.bestTimes = globalData.bestTimes
    }
    if (globalData && globalData.scoreRecords) {
      this.scoreRecords = globalData.scoreRecords
    }
  },

  generateNewScramble() {
    if (this.currentType === "2x2") {
      this.scrambleString = Cube2Core.getScramble(11).join(" ")
    } else {
      this.scrambleString = Cube3Core.getScramble(20).join(" ")
    }
    if (this.isShowPreview) this.preparePreviewData()
  },

  handleTouchStart() {
    if (!this.inspectionEnabled) {
      this.stopAllInspection()
    }

    if (this.isShowPreview) {
      this.hidePreview()
      return
    }

    if (this.isShowActions) {
      this.isMenuExiting = true
      setTimeout(() => {
        this.isShowActions = false
        this.isMenuExiting = false
      }, 120)
      return
    }

    if (this.timerStatus === "running") {
      this.stopTimer()
    } else if (this.timerStatus === "idle") {
      this.penalty = 0
      this.isDNF = false
      this.penaltyText = ""
      this.inspectionStartTime = 0
      this.inspectionEndTime = 0
      this.timerStatus = "prepping"

      this.prepTimeout = setTimeout(() => {
        if (this.inspectionEnabled) {
          this.startInspection()
        }

        this.timerStatus = "ready"
      }, 500)
    }
  },

  handleTouchEnd() {
    if (this.isInspecting) {
      this.stopInspection()
      this.startTimer()
      return
    }

    if (this.timerStatus === "ready") {
      this.startTimer()
    } else if (this.timerStatus === "prepping") {
      clearTimeout(this.prepTimeout)
      this.timerStatus = "idle"
    }
  },

  startInspection() {
    this.isInspecting = true
    this.inspectionTime = 15
    this.inspectionStartTime = Date.now()
    this.inspectionEndTime = 0
    this.penalty = 0
    this.isDNF = false
    this.penaltyText = ""

    this.inspectionTimer = setInterval(() => {
      this.inspectionTime--

      this.timeInt = Math.abs(this.inspectionTime)
      this.timeFraction = "00"
      this.updateInspectionPenalty()

      if (this.inspectionTime <= 0) {
        this.timerStatus = "overtime"
        this.startOvertime()
      }
    }, 1000)
  },

  stopInspection() {
    this.inspectionEndTime = Date.now()
    this.updateInspectionPenalty(this.inspectionEndTime)
    clearInterval(this.inspectionTimer)
    this.inspectionTimer = null
    this.isInspecting = false

    if (this.overtimeTimer) {
      clearInterval(this.overtimeTimer)
      this.overtimeTimer = null
    }
  },

  startOvertime() {
    if (this.overtimeTimer) return

    this.overtime = 0

    this.overtimeTimer = setInterval(() => {
      this.updateInspectionPenalty()
    }, 1000)
  },

  updateInspectionPenalty(now) {
    if (!this.inspectionStartTime) return

    const current = now || Date.now()
    const overtimeSeconds = Math.floor((current - this.inspectionStartTime - 15000) / 1000)

    // ✅ 超过15秒 → +2
    if (overtimeSeconds >= 0) {
      this.penalty = 2
    }

    // ✅ 超过17秒 → DNF
    if (overtimeSeconds >= 2) {
      this.isDNF = true
    }
  },

  startTimer() {
    this.timerStatus = "running"
    this.startTime = Date.now()

    this.timerInterval = setInterval(() => {
      const ms = Date.now() - this.startTime
      this.showElapsedTime(ms)
    }, 40)
  },

  stopTimer() {
    if (this.timerInterval) {
      clearInterval(this.timerInterval)
      this.timerInterval = null
    }

    if (this.timerStatus === "running") {
      const elapsed = Date.now() - this.startTime

      // 更新判罚（防止 inspection 松手瞬间误差）
      if (this.inspectionEndTime) {
        this.updateInspectionPenalty(this.inspectionEndTime)
      }

      let finalTime = elapsed

      if (this.isDNF) {
        // ❌ DNF
        this.timeInt = "DNF"
        this.timeFraction = ""

        this.recordScore("DNF")
      } else {
        // ✅ +2 判罚
        if (this.penalty === 2) {
          finalTime += 2000
          this.penaltyText = "+2s"
        }

        // ✅ 显示最终时间
        this.showElapsedTime(finalTime)

        // ✅ 存储最终成绩（已处理+2）
        this.recordScore(finalTime)
        this.updateBestTime(finalTime)

        this.saveScores()
      }

      this.timerStatus = "idle"
      this.generateNewScramble()
      this.hasInteracted = false
    }
  },

  showElapsedTime(ms) {
    const formatted = (ms / 1000).toFixed(ms >= 100000 ? 2 : 3)
    const parts = formatted.split(".")
    this.timeInt = parts[0]
    this.timeFraction = parts[1]
  },

  updateBestTime(resultMs) {
    if (typeof resultMs !== "number") return // ❗过滤 DNF

    const cubeType = this.currentType === "2x2" ? "2x2" : "3x3"
    const currentBest = this.bestTimes && this.bestTimes[cubeType]

    if (typeof currentBest === "number" && resultMs >= currentBest) return

    const nextBestTimes = Object.assign({"2x2": null, "3x3": null}, this.bestTimes)
    nextBestTimes[cubeType] = resultMs
    this.bestTimes = nextBestTimes

    const globalData = this.$app.$def.globalData
    if (globalData) {
      globalData.bestTimes = nextBestTimes
    }

    prompt.showToast({
      message: "新最佳！",
      duration: 2000
    })
  },

  recordScore(result) {
    const cubeType = this.currentType === "2x2" ? "2x2" : "3x3"

    const nextRecords = Object.assign({"2x2": [], "3x3": []}, this.scoreRecords)
    const currentRecords = nextRecords[cubeType] || []

    // result 可以是 number 或 "DNF"
    nextRecords[cubeType] = currentRecords.concat([result])

    this.scoreRecords = nextRecords

    const globalData = this.$app.$def.globalData
    if (globalData) {
      globalData.scoreRecords = nextRecords
    }
  },

  saveConfigMerge(newData) {
    const self = this

    file.readText({
      uri: this.CONFIG_PATH,
      success(data) {
        let oldConfig = {}
        try {
          oldConfig = JSON.parse(data.text)
        } catch (e) {}

        const merged = Object.assign({}, oldConfig, newData)
        file.writeText({
          uri: self.CONFIG_PATH,
          text: JSON.stringify(merged)
        })
      },
      fail() {
        file.writeText({
          uri: self.CONFIG_PATH,
          text: JSON.stringify(newData)
        })
      }
    })
  },

  saveScores() {
    const self = this
    file.writeText({
      uri: this.SCORES_PATH,
      text: JSON.stringify({
        bestTimes: this.bestTimes,
        scoreRecords: this.scoreRecords
      })
    })
  },

  setPress(target, state) {
    if (target === "scramble") this.isScramblePressed = state
    if (target === "btn1") this.isBtn1Pressed = state
    if (target === "btn2") this.isBtn2Pressed = state
  },

  handleScrambleClick() {
    this.setPress("scramble", false)
    if (this.timerStatus === "idle") {
      this.hasInteracted = true
      this.isScrambleExiting = true
      setTimeout(() => {
        this.isShowActions = true
        this.isScrambleExiting = false
      }, 120)
    }
  },

  onAction(type) {
    this.isBtn1Pressed = false
    this.isBtn2Pressed = false
    this.isMenuExiting = true
    setTimeout(() => {
      this.isShowActions = false
      this.isMenuExiting = false
      if (type === "refresh") {
        this.isShowPreview = false
        this.generateNewScramble()
      } else if (type === "preview") {
        setTimeout(() => {
          this.preparePreviewData()
          this.isShowPreview = true
        }, 150)
      }
    }, 120)
  },

  hidePreview() {
    this.isShowPreview = false
  },

  updateClock() {
    const now = new Date()
    this.currentTime = `${now.getHours().toString().padStart(2, "0")}:${now
      .getMinutes()
      .toString()
      .padStart(2, "0")}`
  },

  back() {
    app.terminate()
  },

  more() {
    router.push({uri: "pages/more"})
  }
}
</script>

<style>
@font-face {
  font-family: JetBrainsMono;
  src: url("/common/fonts/JetBrainsMono-Bold.ttf");
}
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.touch-blocker {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.header {
  width: 100%;
  height: 84px;
  position: relative;
}
.system-time {
  position: absolute;
  top: 7px;
  width: 100%;
  text-align: center;
  color: #aaaaaa;
  font-size: 24px;
  font-weight: bold;
}
.page-title {
  position: absolute;
  left: 0px;
  top: 35px;
  width: 100%;
  height: 45px;
  font-size: 32px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}
.nav-icon {
  width: 72px;
  height: 72px;
  position: absolute;
  top: 6px;
}
.back-btn {
  left: 6px;
}
.more-btn {
  right: 6px;
}
.main-content {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.timer-box {
  flex-direction: column;
  width: 336px;
  align-items: center;
}
.timer-row {
  flex-direction: row;
  align-items: flex-end;
}
.timer-text-main {
  font-family: "JetBrainsMono";
  font-size: 100px;
  font-weight: bold;
}
.timer-text-small {
  font-family: "JetBrainsMono";
  font-size: 50px;
  font-weight: bold;
  margin-bottom: 12px;
}
.idle {
  color: #ffffff;
}
.prepping {
  color: #ff4444;
}
.ready {
  color: #00ff00;
}
.overtime {
  color: #ff4444;
}
.running {
  color: #ffffff;
}
.preview-center-box {
  width: 100%;
  justify-content: center;
}
.cube-area {
  width: 252px;
  height: 188px;
  position: relative;
}
.face {
  width: 60px;
  height: 60px;
  position: absolute;
}
.dot {
  border-radius: 4px;
  position: absolute;
  border: 1px solid #000;
}
.hint-text {
  color: #666666;
  font-size: 24px;
  text-align: center;
  margin-top: 10px;
}
.scramble-container {
  width: 100%;
  height: 120px;
  background-color: #1a1a1a;
  border-radius: 30px;
  margin-bottom: 10px;
  overflow: hidden;
}
.scramble-click-area,
.action-menu {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
  padding: 10px;
  background-color: #1a1a1a;
  transform-origin: 155px 60px;
}
.scramble-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  text-align: center;
  lines: 3;
  line-height: 30px;
}
.action-btn {
  flex: 1;
  height: 100%;
  font-size: 28px;
  font-weight: bold;
  text-align: center;
  color: #ffffff;
}
.menu-line {
  width: 2px;
  height: 40px;
  background-color: #444444;
}
.menu-pop-in {
  animation-name: menuPopIn;
  animation-duration: 150ms;
  animation-fill-mode: forwards;
  animation-timing-function: ease-out;
}
.menu-pop-out {
  animation-name: menuPopOut;
  animation-duration: 120ms;
  animation-fill-mode: forwards;
  animation-timing-function: ease-in;
}
.press-active {
  animation-name: purePress;
  animation-duration: 80ms;
  animation-fill-mode: forwards;
}

@keyframes menuPopIn {
  0% {
    transform: scale(0.1);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
@keyframes menuPopOut {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.1);
    opacity: 0;
  }
}
@keyframes purePress {
  from {
    transform: scale(1);
  }
  to {
    transform: scale(0.92);
  }
}
</style>
